{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "X Review",
  "version": "1.6.7",
  "description": "Review followed X accounts locally, collect public post observations and open candidates for manual review.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://x.com/*"
  ],
  "action": {
    "default_title": "X Review",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
